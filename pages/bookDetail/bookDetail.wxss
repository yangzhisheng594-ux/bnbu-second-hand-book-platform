/* pages/bookDetail/bookDetail.wxss */
page {
  background-color: #f4f4f4;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  padding-bottom: 120rpx; /* 为底部操作栏留出空间 */
}

/* 主要信息区域 */
.book-main-info-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.image-container {
  width: 100%;
  height: 750rpx; /* 图片区域高度，可调整 */
  position: relative; /* 为了图片序号定位 */
}

.image-swiper, .slide-image {
  width: 100%;
  height: 100%;
}
.placeholder-image {
  background-color: #e0e0e0;
}

.image-count {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
}

.meta-info {
  padding: 30rpx;
}

.price-line {
  margin-bottom: 15rpx;
  display: flex;
  align-items: baseline;
}

.current-price {
  font-size: 48rpx;
  color: #d81e06;
  font-weight: bold;
  margin-right: 15rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.title-author {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 20rpx;
  /* 多行省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}
.author-name {
  font-weight: normal;
  font-size: 30rpx;
  color: #666;
}

.code-share-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #888;
}

.share-button {
  background-color: #f0f0f0;
  color: #555;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 25rpx;
  font-size: 24rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  margin: 0; /* 清除button默认margin */
}
.share-button::after { /* 清除button默认边框 */
  border: none;
}
.share-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

/* 书籍详情内容区域 */
.book-content-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title-detail {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #d81e06;
}

.content-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap; /* 保留换行符 */
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  z-index: 100;
}

.action-button {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: 35rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-to-cart-button {
  background-color: #fff7cc; /* 黄色系 */
  color: #ffa500; /* 橙色字 */
  border: 1rpx solid #ffe58f;
  margin-right: 20rpx;
}
.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.buy-now-button {
  background-color: #d81e06; /* 主题红色 */
  color: #fff;
}