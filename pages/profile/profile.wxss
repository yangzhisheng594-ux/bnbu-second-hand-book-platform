/* pages/profile/profile.wxss */
page {
  background-color: #f4f4f4;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}
.container {
  padding-bottom: 40rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background-color: #fff; /* 或主题色背景 */
  /* background-image: linear-gradient(to right, #4facfe 0%, #00f2fe 100%); */
  /* color: white; */
  margin-bottom: 20rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 2rpx solid #eee;
  background-color: #f0f0f0; /* 占位背景 */
}
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.username {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  /* color: white; */ /* 如果背景是深色 */
}
.edit-profile-btn {
  background-color: rgba(255,255,255,0.2);
  /* color: white; */
  color: #666;
  border: 1rpx solid #ddd; /* 如果背景是白色 */
  border-radius: 30rpx;
  padding: 0 25rpx;
  font-size: 24rpx;
  line-height: 50rpx; height: 50rpx;
  margin: 0;
}
.edit-profile-btn::after { border: none; }

.section-card { /* 通用卡片样式 */
  background-color: #fff;
  margin: 0 20rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.order-section .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.view-all-orders {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}
.arrow-right {
  width: 24rpx;
  height: 24rpx;
  margin-left: 10rpx;
  opacity: 0.7;
}

.order-status-tabs {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 0;
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #555;
  position: relative; /* 为了角标定位 */
  width: 20%; /* 平均分配 */
}
.tab-icon {
  width: 64rpx; /* 图标尺寸 */
  height: 64rpx;
  margin-bottom: 10rpx;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: 0rpx; /* 根据图标大小调整 */
  background-color: #ff5000;
  color: white;
  font-size: 20rpx;
  border-radius: 50%;
  padding: 2rpx 10rpx;
  min-width: 30rpx; /* 最小宽度，使单个数字也好看 */
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.login-button, .logout-button {
  margin: 40rpx 30rpx;
  border-radius: 10rpx;
}
.login-button[type="primary"] {
  background-color: #1AAD19;
}
.logout-button {
  background-color: #f0f0f0;
  color: #555;
}