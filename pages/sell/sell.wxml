<!--pages/sell/sell.wxml-->
<view class="container">
  <!-- 待售书单区域 -->
  <view class="section selling-list-section">
    <view class="section-title">待售书单</view>
    <view class="book-list" wx:if="{{sellingBooks.length > 0}}">
      <view class="book-item" wx:for="{{sellingBooks}}" wx:key="id">
        <image class="book-cover" src="{{item.coverUrl || '/images/placeholder_cover_rect.png'}}" mode="aspectFill"></image>
        <view class="book-info">
          <view class="book-name">{{item.title}}</view>
          <view class="book-detail-line">
            <text class="book-code">课程代码: {{item.courseCode}}</text>
          </view>
          <view class="book-price">出售价格: ¥{{item.price}}</view>
        </view>
        <button class="manage-button" size="mini" bindtap="manageBook" data-id="{{item.id}}">管理</button>
      </view>
    </view>
    <view class="empty-list" wx:else>
      <image class="empty-icon" src="/images/empty_box_icon.png"></image>
      <text>暂无待售书籍</text>
      <!-- 你也可以在这里放一个“去发布”的引导按钮 -->
    </view>
    <view class="load-more" wx:if="{{sellingBooks.length > 0 && hasMoreSelling}}">点击加载更多</view>
    <view class="no-more" wx:if="{{sellingBooks.length > 0 && !hasMoreSelling && sellingBooks.length >= 10}}">没有更多了</view>
  </view>

  <!-- 最近求购区域 -->
  <view class="section seeking-list-section">
    <view class="section-title">最近求购</view>
    <view class="book-list" wx:if="{{seekingBooks.length > 0}}">
      <view class="book-item" wx:for="{{seekingBooks}}" wx:key="id">
        <image class="book-cover" src="{{item.coverUrl || '/images/placeholder_cover_rect.png'}}" mode="aspectFill"></image>
        <view class="book-info">
          <view class="book-name">{{item.title}}</view>
          <view class="book-detail-line">
            <text class="book-code">课程代码: {{item.courseCode}}</text>
          </view>
          <view class="book-price seeking-price">求购价格: ¥{{item.seekingPrice}}</view>
        </view>
        <!-- 根据需求，求购列表项可能没有管理按钮，或者有不同的操作，如“我有此书” -->
        <button class="manage-button respond-button" size="mini" bindtap="respondToSeek" data-id="{{item.id}}">我有此书</button>
      </view>
    </view>
    <view class="empty-list" wx:else>
      <image class="empty-icon" src="/images/empty_box_icon.png"></image>
      <text>暂无求购信息</text>
    </view>
    <view class="load-more" wx:if="{{seekingBooks.length > 0 && hasMoreSeeking}}">点击加载更多</view>
    <view class="no-more" wx:if="{{seekingBooks.length > 0 && !hasMoreSeeking && seekingBooks.length >= 10}}">没有更多了</view>
  </view>

  <!-- 底部发布按钮 -->
  <view class="publish-button-fixed">
    <button class="publish-button" bindtap="navigateToPublishNew">点击发布</button>
  </view>
</view>