<!--pages/request/request.wxml-->
<view class="container">
  <!-- 我的求购列表区域 -->
  <view class="section request-list-section">
    <view class="section-title">我的求购</view>
    <view class="book-list" wx:if="{{myRequests.length > 0}}">
      <view class="book-item" wx:for="{{myRequests}}" wx:key="id">
        <image class="book-cover" src="{{item.coverUrl || '/images/placeholder_cover_rect.png'}}" mode="aspectFill"></image>
        <view class="book-info">
          <view class="book-name">{{item.title}}</view>
          <view class="book-detail-line">
            <text class="book-code">课程代码: {{item.courseCode || '未填写'}}</text>
          </view>
          <view class="book-price seeking-price">期望价格: ¥{{item.expectedPrice}}</view>
        </view>
        <button class="manage-button" size="mini" bindtap="manageRequest" data-id="{{item.id}}">管理</button>
      </view>
    </view>
    <view class="empty-list" wx:else>
      <image class="empty-icon" src="/images/empty_box_icon.png"></image>
      <text>暂无求购信息</text>
    </view>
    <view class="load-more" wx:if="{{myRequests.length > 0 && hasMoreRequests}}">点击加载更多</view>
    <view class="no-more" wx:if="{{myRequests.length > 0 && !hasMoreRequests && myRequests.length >= 10}}">没有更多了</view>
  </view>

  <!-- 底部发布按钮 -->
  <view class="publish-button-fixed">
    <button class="publish-button" bindtap="navigateToPublishNewRequest">点击发布</button>
  </view>
</view>