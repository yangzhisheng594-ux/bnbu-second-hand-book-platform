<!--pages/cart/cart.wxml-->
<view class="container">
  <!-- 顶部管理栏 -->
  <view class="cart-header">
    <text class="total-count">共 {{cartItems.length}} 件宝贝</text>
    <button class="manage-toggle-btn" size="mini" bindtap="toggleManageMode">
      {{isManaging ? '退出管理' : '管理'}}
    </button>
  </view>

  <!-- 购物车列表 -->
  <scroll-view scroll-y class="cart-list-scroll" wx:if="{{cartItems.length > 0}}">
    <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
      <view class="select-checkbox {{item.selected ? 'selected' : ''}}" bindtap="toggleSelectItem" data-index="{{index}}">
        <icon wx:if="{{item.selected}}" type="success_no_circle" size="18" color="#fff"></icon>
      </view>
      <image class="item-cover" src="{{item.coverUrl}}" mode="aspectFill"></image>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-code">{{item.courseCode}}</view>
        <view class="item-price">¥{{item.price.toFixed(2)}}</view>
        <!-- 如果需要数量控制器 -->
        <!--
        <view class="item-quantity-control" wx:if="{{!isManaging}}">
          <button size="mini" bindtap="decreaseQuantity" data-index="{{index}}">-</button>
          <text>{{item.quantity}}</text>
          <button size="mini" bindtap="increaseQuantity" data-index="{{index}}">+</button>
        </view>
        -->
      </view>
    </view>
  </scroll-view>

  <view class="empty-cart" wx:else>
    <image class="empty-icon" src="/images/empty_cart_icon.png"></image>
    <text>购物车还是空的</text>
    <button class="go-shopping-btn" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="select-all-checkbox {{isAllSelected ? 'selected' : ''}}" bindtap="toggleSelectAll">
      <icon wx:if="{{isAllSelected}}" type="success_no_circle" size="18" color="#fff"></icon>
    </view>
    <text class="select-all-text">全选</text>

    <view class="summary-action">
      <block wx:if="{{!isManaging}}">
        <text class="total-price-label">合计：</text>
        <text class="total-price-value">¥{{totalPrice.toFixed(2)}}</text>
        <button class="checkout-btn" bindtap="checkout" disabled="{{selectedCount === 0}}">
          结算({{selectedCount}})
        </button>
      </block>
      <block wx:else>
        <text class="selected-info-text">已选：{{selectedCount}} 件</text>
        <button class="delete-btn" bindtap="deleteSelectedItems" disabled="{{selectedCount === 0}}">
          删除
        </button>
      </block>
    </view>
  </view>
</view>